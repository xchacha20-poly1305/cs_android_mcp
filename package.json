{
  "name": "@anrong/cs-android-mcp",
  "version": "1.1.1",
  "description": "MCP server for Android Code Search (cs.android.com)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "cs-android-mcp": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/test.*"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node --test test/live/*.test.mjs",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "mcp",
    "android",
    "code-search",
    "cs.android.com",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xchacha20-poly1305/cs_android_mcp.git"
  },
  "homepage": "https://github.com/xchacha20-poly1305/cs_android_mcp",
  "license": "MIT"
}
